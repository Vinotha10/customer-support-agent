# Copy this file to .env (same folder) and fill in your real values.
# .env is gitignored -- never commit real API keys.

# Which provider llm_client.py / reply_agent.py should use: "anthropic", "gemini", or "ollama"
LLM_PROVIDER=ollama

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ollama needs no key -- install from ollama.com, then `ollama pull llama3.2:3b`

